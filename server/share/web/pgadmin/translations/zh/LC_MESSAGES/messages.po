#~ "displays Yes if the session is "
#~ "waiting for a lock No if the "
#~ "session is not waiting for a "
#~ "lock.<br/><b>Backend Start:</b> The date and"
#~ " time that the client established a"
#~ " connection to the server.<br/><b>Transaction "
#~ "Start:</b> The date and time that "
#~ "the current transaction started, if "
#~ "applicable.<br/><b>Query Start:</b> The date "
#~ "and time that the current query "
#~ "started, if applicable.<br/><b>Memory Usage:</b> "
#~ "Memory used (in megabytes) by that "
#~ "session.<br/><b>Swap Usage:</b> Swap used (in"
#~ " megabytes) by that session.<br/><b>CPU "
#~ "Usage:</b> CPU used (in percentage) by"
#~ " that session.<br/><b>IO Reads (#bytes):</b> "
#~ "Number of IO blockes (in bytes) "
#~ "read by that session.<br/><b>IO Writes "
#~ "(#bytes):</b> Number of IO blockes (in"
#~ " bytes) write by that session"
#~ msgstr ""

#~ msgid ""
#~ "This table displays a list of "
#~ "locks held by processes on the "
#~ "server. Click a column heading to "
#~ "sort the table data by the "
#~ "selected column click the heading a "
#~ "second time to reverse the sort "
#~ "order. The Session Lock Activity table"
#~ " displays the following "
#~ "information:<br/><br/><b>Session ID:</b> The process"
#~ " ID for the session.<br/><b>User Name:</b>"
#~ " The name of the user holding "
#~ "(or waiting for) the lock.<br/><b>Source:</b>"
#~ " This column displays the IP address"
#~ " and port number of the "
#~ "client.<br/><b>Database Name:</b> The name of"
#~ " the database to which the client "
#~ "is connected.<br/><b>Blocked:</b> This column "
#~ "indicates if the lock request is "
#~ "blocked by another lock.<br/><b>Blocked "
#~ "By:</b> This column specifies the "
#~ "session ID of the session that is"
#~ " holding the lock.<br/><b>Lock Type:</b> "
#~ "The type of lock that is held "
#~ "by the client. Lock Type may "
#~ "be:<br/>-  <i>advisory:</i> a user-d lock "
#~ "created by pg_advisory_lock() or "
#~ "pg_advisory_lock_shared(),<br/>-  <i>extend:</i> a "
#~ "lock held while extending a table "
#~ "or index,<br/>-  <i>object:</i> a lock "
#~ "held on a database object,<br/>-  "
#~ "<i>page:</i> a lock held on a page"
#~ " (within the shared buffer cache),<br/>-"
#~ "  <i>relation:</i> a lock held on the"
#~ " metadata describing a table, view, "
#~ "or sequence (to prevent another session"
#~ " from altering the table, view, or"
#~ " sequence),<br/>-  <i>transactionid:</i> a lock"
#~ " held on a transaction ID (one "
#~ "session typically waits for another "
#~ "transaction to complete by waiting on"
#~ " the other session's transaction ID),<br/>-"
#~ "  <i>tuple:</i> lock held on a tuple"
#~ " (typically, a tuple which has been"
#~ " inserted, updated, or deleted, but "
#~ "not yet committed),<br/>-  <i>userlock:</i> a"
#~ " user-d lock created with the LOCK"
#~ " statement,<br/>-  <i>virtualxid:</i> a lock "
#~ "identified by a virtual transaction "
#~ "ID,<br/><b>Object ID:</b> The OID of the"
#~ " relation, or NULL if the object "
#~ "is not a relation (of part of "
#~ "a relation).<br/><b>Mode:</b> The name of "
#~ "the lock mode help (or sought) by"
#~ " the process.<br/><b>Transaction Start:</b> The"
#~ " date and time that the transaction"
#~ " started."
#~ msgstr ""

